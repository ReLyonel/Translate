{
  "name": "foundry-translator",
  "private": true,
  "version": "0.4.9",
  "type": "module",
  "scripts": {
    "dev": "bun run build && tsx desktop/launch.ts",
    "build": "vite build && tsx desktop/build.config.ts",
    "start": "tsx desktop/launch.ts",
    "clean": "node -e \"for (const p of ['dist','dist-desktop']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "memory:resolve:audit": "tsx scripts/resolvePdfMemory.ts",
    "benchmark:plan": "tsx scripts/prepareTranslateGemmaBenchmark.ts",
    "corpus:list": "tsx scripts/corpus.ts list",
    "corpus:scan": "tsx scripts/corpus.ts scan",
    "corpus:extract": "tsx scripts/corpus.ts extract",
    "corpus:inspect": "tsx scripts/corpus.ts inspect",
    "corpus:report": "tsx scripts/corpus.ts report",
    "memory:build": "tsx scripts/buildTranslationMemory.ts",
    "package:win": "bun run build && electron-builder --win portable --x64",
    "package:dir": "bun run build && electron-builder --win --dir",
    "smoke:desktop": "tsx desktop/launch.ts --smoke-test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "acorn": "^8.18.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  },
  "description": "Traductor local de contenido Foundry VTT para Windows",
  "author": "Foundry Translator",
  "main": "dist-desktop/main.cjs"
}
