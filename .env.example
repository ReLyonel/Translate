# All processing uses the local Ollama server. Do not put cloud credentials here.
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11500
OLLAMA_MODEL=translategemma:27b
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0
OLLAMA_KEEP_ALIVE=30m

# PDFs are read in place; they are never copied to the repository or uploaded.
PDF_SOURCE_DIR="C:\Users\leond\OneDrive\Escritorio\Nueva carpeta"
